{
  "name": "sheetfit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pack photo copies onto printable sheets with as little waste as possible.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "bench:report": "vitest run --config vitest.report.config.ts",
    "e2e": "npm run e2e:layout && npm run e2e:controls && npm run e2e:pdf && npm run e2e:a11y && npm run e2e:presets && npm run e2e:import && npm run e2e:selection && npm run e2e:print && npm run e2e:timelimit && npm run e2e:persist",
    "e2e:layout": "node e2e/layout.mjs",
    "e2e:controls": "node e2e/controls.mjs",
    "e2e:pdf": "node e2e/pdf-export.mjs",
    "e2e:a11y": "node e2e/a11y.mjs",
    "e2e:presets": "node e2e/presets.mjs",
    "e2e:import": "node e2e/import.mjs",
    "e2e:selection": "node e2e/selection.mjs",
    "e2e:print": "node e2e/print.mjs",
    "e2e:timelimit": "node e2e/timelimit.mjs",
    "e2e:persist": "node e2e/persist.mjs",
    "e2e:perf": "node e2e/responsiveness.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "1.56.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
